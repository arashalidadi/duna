generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// FOUNDATIONAL ENTITIES — PHASE 1
// ============================================================================
// These entities establish the architectural foundation. Detailed business
// entities (Cargo, Inspection, Voyage, Invoice, Payment, etc.) will be added
// in later phases following the conventions established here.
//
// Conventions:
//   * UUID primary keys (cuid() for ordered, distributed-friendly ids)
//   * createdAt / updatedAt audit timestamps
//   * soft deletion via deletedAt (nullable) where appropriate
//   * explicit status fields
//   * all timestamps stored in UTC
// ============================================================================

// ---------------------------------------------------------------------------
// Identity & Access (RBAC foundation — fully implemented in Phase 2)
// ---------------------------------------------------------------------------

model User {
  id                      String           @id @default(cuid())
  email                   String           @unique
  passwordHash            String
  fullName                String
  isActive                Boolean          @default(true)
  lastLoginAt             DateTime?
  failedLoginAttempts     Int              @default(0)
  lockedUntil             DateTime?
  passwordChangedAt       DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  deletedAt               DateTime?
  roles                   UserRole[]
  refreshTokens           RefreshToken[]
  inspectionsCreated      Inspection[]     @relation("InspectorCreated")
  inspectionsApproved     Inspection[]     @relation("InspectorApproved")
  inspectionsRejected     Inspection[]     @relation("InspectorRejected")
  voyagesCreated          Voyage[]         @relation("VoyageCreated")
  loadListsCreated        LoadList[]       @relation("LoadListCreatedBy")
  loadListsFinalized      LoadList[]       @relation("LoadListFinalizedBy")
  loadListsCancelled      LoadList[]       @relation("LoadListCancelledBy")
  actualLoadingsCreated   ActualLoading[]  @relation("ActualLoadingCreatedBy")
  actualLoadingsCompleted ActualLoading[]  @relation("ActualLoadingCompletedBy")
  actualLoadingsCancelled ActualLoading[]  @relation("ActualLoadingCancelledBy")
  dischargesCreated       Discharge[]      @relation("DischargeCreatedBy")
  dischargesCompleted     Discharge[]      @relation("DischargeCompletedBy")
  dischargesCancelled     Discharge[]      @relation("DischargeCancelledBy")
  manifestsCreated        Manifest[]       @relation("ManifestCreatedBy")
  manifestsSubmitted      Manifest[]       @relation("ManifestSubmittedBy")
  manifestsApproved       Manifest[]       @relation("ManifestApprovedBy")
  manifestsCancelled      Manifest[]       @relation("ManifestCancelledBy")
  billsCreated            BillOfLading[]   @relation("BillCreatedBy")
  billsIssued             BillOfLading[]   @relation("BillIssuedBy")
  billsCancelled          BillOfLading[]   @relation("BillCancelledBy")
  invoicesCreated         Invoice[]        @relation("InvoiceCreatedBy")
  invoicesIssued          Invoice[]        @relation("InvoiceIssuedBy")
  vouchersCreated         Voucher[]        @relation("VoucherCreatedBy")
  deliveryOrdersCreated   DeliveryOrder[]  @relation("DeliveryOrderCreatedBy")
  deliveryOrdersCancelled DeliveryOrder[]  @relation("DeliveryOrderCancelledBy")
  releaseOrdersCreated    ReleaseOrder[]   @relation("ReleaseOrderCreatedBy")
  releaseOrdersCancelled  ReleaseOrder[]   @relation("ReleaseOrderCancelledBy")
  vouchersCancelled       Voucher[]        @relation("VoucherCancelledBy")
  invoicesCancelled       Invoice[]        @relation("InvoiceCancelledBy")
  proformasCreated        Proforma[]       @relation("ProformaCreatedBy")
  proformasIssued         Proforma[]       @relation("ProformaIssuedBy")
  proformasCancelled      Proforma[]       @relation("ProformaCancelledBy")
  quotationsCreated       Quotation[]      @relation("QuotationCreatedBy")
  quotationsSent          Quotation[]      @relation("QuotationSentBy")
  quotationsAccepted      Quotation[]      @relation("QuotationAcceptedBy")
  quotationsRejected      Quotation[]      @relation("QuotationRejectedBy")
  quotationsCancelled     Quotation[]      @relation("QuotationCancelledBy")
  employeesCreated        Employee[]       @relation("EmployeeCreatedBy")
  salaryRecordsCreated    SalaryRecord[]   @relation("SalaryCreatedBy")
  salaryRecordsApproved   SalaryRecord[]   @relation("SalaryApprovedBy")
  salaryRecordsPaid       SalaryRecord[]   @relation("SalaryPaidBy")
  salaryRecordsCancelled  SalaryRecord[]   @relation("SalaryCancelledBy")
  lettersCreated          Letter[]         @relation("LetterCreatedBy")
  lettersSent             Letter[]         @relation("LetterSentBy")
  lettersArchived         Letter[]         @relation("LetterArchivedBy")
  jobsCreated             Job[]            @relation("JobCreatedBy")
  jobsCompleted           Job[]            @relation("JobCompletedBy")
  jobsCancelled           Job[]            @relation("JobCancelledBy")
  portalCustomerId        String?          @unique @map("portalCustomerId") // customer this user acts for (agent portal)
  portalCustomer          Customer?        @relation("UserPortalCustomer", fields: [portalCustomerId], references: [id])
  // Phase 2 (party-cutover-plan.md §3 addendum): Agent master this user acts for;
  // drives portal manifest scoping once manifests.agentId points at agents.
  // portalCustomerId above is RETAINED (bookings/statement still Customer-scoped).
  portalAgentId           String?          @unique @map("portalAgentId")
  portalAgent             Agent?           @relation("UserPortalAgent", fields: [portalAgentId], references: [id])
  bookingsSubmitted       BookingRequest[] @relation("BookingSubmittedBy")
  bookingsHandled         BookingRequest[] @relation("BookingHandledBy")

  @@index([email])
  @@index([isActive])
}

// Refresh tokens are stored hashed (never plaintext). Rotated on use; the prior
// token is soft-revoked and linked to its replacement for reuse detection.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  lookupKey         String?   @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String           @id @default(cuid())
  code      String           @unique
  module    String
  action    String // create | read | update | delete | approve | ...
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  roles     RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Company & Money
// ---------------------------------------------------------------------------

model CompanySettings {
  id                      String   @id @default(cuid())
  companyName             String
  legalName               String?
  registrationNumber      String?
  taxNumber               String?
  address                 String?
  city                    String?
  country                 String?
  phone                   String?
  email                   String?
  website                 String?
  timezone                String   @default("Asia/Dubai")
  defaultCurrency         String   @default("USD")
  supportedCurrenciesJson String   @default("[\"USD\",\"AED\"]")
  createdByUserId         String?
  updatedByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique // ISO 4217, e.g. USD, AED
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Geography: Ports -> Yards
// ---------------------------------------------------------------------------

model Port {
  id                    String           @id @default(cuid())
  code                  String           @unique // e.g. JEBALI, KHALIFA
  name                  String
  country               String
  city                  String?
  abbreviation          String?         @unique @map("abbreviation") // short code e.g. HAM, JEA; nullable during migration
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  yards                 Yard[]
  cargos                Cargo[]          @relation("CargoPort") // cargo registered at this port
  cargoDestinations     Cargo[]          @relation("DestinationPort") // cargo destined for this port
  yardInventories       YardInventory[] // current inventory physically at this port
  voyageOrigins         Voyage[]         @relation("VoyageOrigin") // voyages departing from this port
  voyageDestinations    Voyage[]         @relation("VoyageDestination") // voyages arriving at this port
  voyageLegs            VoyageDestination[] @relation("VoyageLegPort") // destination legs of voyages
  manifestsAsPol        Manifest[]       @relation("ManifestPol") // manifests loaded at this port
  manifestsAsPod        Manifest[]       @relation("ManifestPod") // manifests discharged at this port
  bookingsAsOrigin      BookingRequest[] @relation("BookingOrigin")
  bookingsAsDestination BookingRequest[] @relation("BookingDestination")
  agentDestinations     AgentDestination[]

  @@index([name])
  @@index([country])
  @@index([isActive])
}

model Yard {
  id          String          @id @default(cuid())
  portId      String
  code        String          @unique
  name        String
  address     String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  cargos      Cargo[] // cargo currently assigned to this yard
  inventories YardInventory[] // current inventory records held in this yard

  port Port @relation(fields: [portId], references: [id])

  @@index([portId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Customers (will have many Cargo records in later phases)
// ---------------------------------------------------------------------------

model Customer {
  id                     String           @id @default(cuid())
  code                   String           @unique // configurable numbering, e.g. CUS-001
  name                   String
  shortName              String?
  type                   String? // e.g. SHIPPER, CONSIGNEE, AGENT, FREIGHT_FORWARDER
  contactName            String?
  phone                  String?
  email                  String?
  address                String?
  country                String?
  taxId                  String?
  creditLimit            Decimal?         @db.Decimal(18, 2)
  currency               String? // ISO 4217
  isActive               Boolean          @default(true)
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?
  cargos                 Cargo[] // all cargo consigned to this customer
  invoicesIssuedTo       Invoice[]        @relation("InvoiceCustomer")
  proformasIssuedTo      Proforma[]       @relation("ProformaCustomer")
  quotationsIssuedTo     Quotation[]      @relation("QuotationCustomer")
  letters                Letter[]         @relation("LetterCustomer")
  jobs                   Job[]            @relation("JobCustomer")
  deliveryOrdersReceived DeliveryOrder[]  @relation("DeliveryOrderRecipient")
  vouchersReceived       Voucher[]        @relation("VoucherCustomer")
  bookings               BookingRequest[] @relation("BookingAgent") // bookings submitted via the agent portal
  portalUsers            User[]           @relation("UserPortalCustomer")

  @@index([name])
  @@index([isActive])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Party Masters (Phase 2) — Shipper, Consignee, Agent are separate from
// Customer. Customer remains the internal commercial counterparty.
// Customer.type is deprecated for representing these external parties.
// ---------------------------------------------------------------------------

model Shipper {
  id          String   @id @default(cuid())
  code        String   @unique // master-data code, e.g. SPH-001
  name        String
  taxId       String?  @map("taxId") // TRN / national ID where applicable
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([code])
  @@index([name])
  @@index([isActive])
  @@map("shippers")

  cargos Cargo[] @relation("ShipperCargo")
  manifests Manifest[] @relation("ManifestShipper")
  bills     BillOfLading[] @relation("BillShipper")
}

model Consignee {
  id          String   @id @default(cuid())
  code        String   @unique // master-data code, e.g. CSG-001
  name        String
  taxId       String?  @map("taxId") // TRN / national ID where applicable
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([code])
  @@index([name])
  @@index([isActive])
  @@map("consignees")

  cargos Cargo[] @relation("ConsigneeCargo")
  manifests Manifest[] @relation("ManifestConsignee")
  bills     BillOfLading[] @relation("BillConsignee")
}

model Agent {
  id          String   @id @default(cuid())
  code        String   @unique // master-data code, e.g. AGT-001
  name        String
  taxId       String?  @map("taxId") // TRN / national ID where applicable
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  destinations AgentDestination[]
  portalUsers  User[] @relation("UserPortalAgent") // portal accounts linked to this agent
  manifests    Manifest[] @relation("ManifestAgent")

  @@index([code])
  @@index([name])
  @@index([isActive])
  @@map("agents")
}

model AgentDestination {
  id          String   @id @default(cuid())
  agentId     String
  portId      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  port        Port      @relation(fields: [portId], references: [id], onDelete: Cascade)

  @@unique([agentId, portId])
  @@index([agentId])
  @@index([portId])
  @@index([isActive])
  @@map("agent_destinations")
}

// ---------------------------------------------------------------------------
// Cargo
// ---------------------------------------------------------------------------
// Cargo is the core operational record. It references Customers, Ports and
// Yards through real foreign keys (Phase 3 master data) — it never duplicates
// their names. The lifecycle (status) and the readiness fields (inspection /
// loading / manifest) are established here; the associated business workflows
// (Inspection, Load List, Actual Loading, Manifest) belong to later phases and
// only extend these explicit states.
//
// Lifecycle status is an explicit state machine (see docs/workflows.md and
// ADR-019). Terminals: CANCELLED (and, via later phases, LOADED/DELIVERED).
// READY additionally requires inspectionStatus = APPROVED.
//
// Timezone: all timestamps are UTC (project convention).

model Cargo {
  id                String           @id @default(cuid())
  reference         String           @unique // stable, human-friendly, e.g. CRG-XXXXXXXX
  customerId        String           @map("customerId")
  portId            String           @map("portId") // port where the cargo is registered / handled
  yardId            String?          @map("yardId") // current yard assignment (must belong to portId)
  destinationPortId String?          @map("destinationPortId") // relational destination
  pol               String?          @map("pol") // port of loading
  pod               String?          @map("pod") // port of discharge
  // Phase 2: nullable party master refs for B/L generation (Phase 4).
  // Customer remains the commercial counterparty (customerId above).
  shipperId        String?          @map("shipperId")
  consigneeId      String?          @map("consigneeId")
  // Phase 3: optional cargo value and currency (DB columns already present).
  cargoValue           Decimal?      @db.Decimal(18, 2)  @map("cargoValue")
  cargoValueCurrency   String?       @map("cargoValueCurrency")
  jobId                String?       @map("jobId")
  description          String?       @map("description")
  chassis              String?       @map("chassis")
  serial               String?       @map("serial")
  units                Int?          @map("units")
  cargoType         CargoType
  specification     String?
  serialNumber      String?          @map("serialNumber")
  chassisNumber     String?          @map("chassisNumber")
  vin               String?
  weight            Decimal?         @db.Decimal(18, 2) // gross weight where applicable
  weightUnit        WeightUnit? // KG or MT (documented standard)
  quantity          Int? // positive unit count where applicable
  packages          Int? // package / naggle count where applicable
  packageType       String? // e.g. NAGGLE, BUNDLE, LOOSE
  arrivalDate       DateTime?        @map("arrivalDate") // UTC
  arrivalReference  String?          @map("arrivalReference") // e.g. B/L or shipping reference
  inspectionStatus  InspectionStatus @default(PENDING) // readiness; workflow in Phase 5
  loadingStatus     LoadingStatus    @default(NOT_LOADED) // readiness; loading in Phase 8
  manifestNumber    String?          @map("manifestNumber") // nullable; manifest in Phase 9
  status            CargoStatus      @default(REGISTERED)
  comments          String?
  comment           String?          @map("comment")
  createdById       String?          @map("createdById") // audit-readiness (full audit in Phase 19)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  customer        Customer @relation(fields: [customerId], references: [id])
  port            Port     @relation("CargoPort", fields: [portId], references: [id])
  destinationPort Port?    @relation("DestinationPort", fields: [destinationPortId], references: [id])
  yard            Yard?    @relation(fields: [yardId], references: [id])
  // Phase 2: nullable party master refs for B/L generation (Phase 4).
  // Customer remains the commercial counterparty (customerId above).
  shipper         Shipper?  @relation("ShipperCargo", fields: [shipperId], references: [id])
  consignee       Consignee? @relation("ConsigneeCargo", fields: [consigneeId], references: [id])

  inventory          YardInventory? // one current inventory record per cargo (Phase 4 minimal)
  dischargeItems     DischargeItem[]
  inspections        Inspection[] // completed/pending inspections against this cargo (Phase 5)
  loadListItems      LoadListItem[]
  actualLoadingItems ActualLoadingItem[]
  manifestItems      ManifestItem[]
  billsOfLadingItems BillOfLadingItem[]  @relation("BillOfLadingItemCargo")

  // unique index on @unique(reference) covers reference lookups
  @@index([customerId])
  @@index([portId])
  @@index([yardId])
  @@index([destinationPortId])
  @@index([shipperId])
  @@index([consigneeId])
  @@index([status])
  @@index([inspectionStatus])
  @@index([cargoType])
  @@index([serialNumber])
  @@index([chassisNumber])
  @@index([vin])
  @@index([arrivalDate])
}

// ---------------------------------------------------------------------------
// Yard Inventory (current state) — Phase 4
// ---------------------------------------------------------------------------
// YardInventory records the CURRENT physical presence of a Cargo in a Yard.
// Exactly one current record exists per Cargo (@@unique cargoId) while it is
// in the yard; placing creates it, moving updates it, removing deletes it.
// A cargo that is not currently in any yard has NO inventory record.
// This satisfies "current inventory determination" and duplicate prevention;
// full historical movement is deferred (documented in ADR-020 / limitations).
// portId mirrors yard.portId and is kept in sync by the service for indexed
// port-level filtering.

model YardInventory {
  id            String          @id @default(cuid())
  cargoId       String          @unique @map("cargoId") // one current record per cargo
  yardId        String          @map("yardId")
  portId        String          @map("portId") // mirror of yard.portId (kept in sync)
  status        InventoryStatus @default(IN_YARD)
  enteredAt     DateTime        @default(now()) @map("enteredAt") // UTC
  locationLabel String?         @map("locationLabel") // optional zone/row/slot
  notes         String? // movement/reason; not a substitute for structured fields
  createdById   String?         @map("createdById")
  updatedById   String?         @map("updatedById")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  cargo Cargo @relation(fields: [cargoId], references: [id])
  yard  Yard  @relation(fields: [yardId], references: [id])
  port  Port  @relation(fields: [portId], references: [id])

  @@index([yardId])
  @@index([portId])
  @@index([status])
  @@index([enteredAt])
}

// ---------------------------------------------------------------------------
// Inspection (operational) — Phase 5
// ---------------------------------------------------------------------------
// Inspection records the outcome of an inspection of a Cargo. It is a *history*
// record: an approved/rejected inspection transitions the cargo's current
// readiness state (Cargo.inspectionStatus) transactionally, but prior inspection
// records are preserved for traceability. A cargo may have Inspection #1
// REJECTED then Inspection #2 APPROVED; Cargo.inspectionStatus reflects the
// latest (authoritative current state), while every Inspection row remains.
//
// The current-state authority: Cargo.inspectionStatus (Phase 4 field). The
// Inspection table is the traceable ledger of how that state was reached.
// `approve`/`reject` update the Inspection row AND Cargo.inspectionStatus in the
// same transaction so they can never diverge (ADR-024).
//
// Duplicate-pending rule: at most one PENDING inspection per cargo at a time.
// Enforced in the service layer and backed by a partial unique index on
// (cargoId) WHERE status = 'PENDING' (added in migration) so concurrent creates
// are safe.
//
// Timezone: inspectionDate and all timestamps are UTC (project convention).

model Inspection {
  id                String           @id @default(cuid())
  inspectionNumber  String           @unique // stable, human-friendly, e.g. INS-YYMM-#####
  cargoId           String           @map("cargoId")
  status            InspectionStatus @default(PENDING)
  inspectionDate    DateTime         @map("inspectionDate") // UTC
  inspectorId       String?          @map("inspectorId") // the user recording the inspection
  inspectorName     String?          @map("inspectorName") // free-text snapshot (external inspectors)
  findings          String? // structured free-form findings
  condition         String? // physical condition / damage notes
  verificationNotes String?          @map("verificationNotes") // serial/chassis, qty, weight, documentation
  remarks           String?
  rejectionReason   String?          @map("rejectionReason") // required on REJECTED

  approvedById String?   @map("approvedById")
  approvedAt   DateTime? @map("approvedAt") // UTC
  rejectedById String?   @map("rejectedById")
  rejectedAt   DateTime? @map("rejectedAt") // UTC

  createdById String?  @map("createdById") // audit-readiness (full audit in Phase 19)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cargo      Cargo @relation(fields: [cargoId], references: [id])
  createdBy  User? @relation("InspectorCreated", fields: [createdById], references: [id])
  approvedBy User? @relation("InspectorApproved", fields: [approvedById], references: [id])
  rejectedBy User? @relation("InspectorRejected", fields: [rejectedById], references: [id])

  @@index([cargoId])
  @@index([status])
  @@index([inspectionDate])
  @@index([inspectorId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Vessel (master data) — Phase 6
// ---------------------------------------------------------------------------
// Vessel is the operational master / registry record. A vessel is identified by
// a unique, stable `code` (master-data convention, mirroring Port/Customer) and
// optionally by IMO number (unique when supplied). `flag` is a plain country
// string — consistent with Port.country (no separate Country master table yet).
//
// Lifecycle: ACTIVE / INACTIVE via isActive. Deactivation is guarded: a vessel
// with an unfinished voyage (DRAFT/SCHEDULED/IN_PROGRESS) cannot be deactivated
// (409); completed historical voyages do not block deactivation and remain
// readable. Vessels are not hard-deleted while referenced by any voyage.
//
// `capacityTeu` is declared master-data stowage capacity (informational only;
// no slot allocation / utilization logic — that belongs to Load Planning, Phase 7).
//
// Timezone: all timestamps UTC (project convention).

model Vessel {
  id          String     @id @default(cuid())
  code        String     @unique // stable, unique master-data code, e.g. MV-HORIZON
  name        String // required vessel name (trimmed / non-blank enforced in service)
  imo         String?    @unique // 7-digit IMO number; nullable, validated when supplied
  flag        String // country of registry (plain string, matches Port.country)
  vesselType  VesselType
  capacityTeu Int? // declared stowage capacity (TEU), master-data only
  isActive    Boolean    @default(true)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime? // soft-delete (blocked while voyages reference the vessel)

  voyages Voyage[]
  tugVoyages   Voyage[]      @relation("VoyageTug")
  bargeVoyages Voyage[]      @relation("VoyageBarge")

  @@index([code])
  @@index([name])
  @@index([flag])
  @@index([vesselType])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Voyage (operational) — Phase 6
// ---------------------------------------------------------------------------
// Voyage is an operational sailing of a Vessel between an origin and a
// destination port. It carries the vessel + port relationships that Phase 7
// (Load Planning) will consume, but NO cargo assignment (that is explicitly
// Phase 7). The explicit lifecycle (VoyageStatus) is server-enforced.
//
// Lifecycle states and transitions (ADR-026):
//   DRAFT      -> SCHEDULED | CANCELLED
//   SCHEDULED  -> IN_PROGRESS | CANCELLED
//   IN_PROGRESS-> COMPLETED
//   COMPLETED / CANCELLED are terminal (historical).
// Status changes are dedicated business operations (schedule/start/complete/
// cancel), never an arbitrary PATCH of the status field.
//
// Dates are planned scheduling times, stored in UTC. `plannedDepartureAt` and
// `plannedArrivalAt` (ETA) are required to SCHEDULE; ordering
// plannedArrivalAt >= plannedDepartureAt is validated. Actual operation
// timestamps belong to later phases.
//
// A vessel may not have overlapping unfinished voyages (DRAFT/SCHEDULED/
// IN_PROGRESS) — enforced in the service (403/409 on overlap, ADR-027).
//
// Timezone: all timestamps UTC (project convention).

model Voyage {
  id                 String       @id @default(cuid())
  voyageNumber       String       @unique // stable, unique, auto VOY-YYMM-#####
  vesselId           String       @map("vesselId")
  tugVesselId        String?      @map("tugVesselId")
  bargeVesselId      String?      @map("bargeVesselId")
  status             VoyageStatus @default(DRAFT)
  originPortId       String       @map("originPortId")
  destinationPortId  String       @map("destinationPortId")
  plannedDepartureAt DateTime?    @map("plannedDepartureAt") // UTC; required to schedule
  plannedArrivalAt   DateTime?    @map("plannedArrivalAt") // ETA UTC; required to schedule
  cancelReason       String?      @map("cancelReason") // required on cancellation
  notes              String?
  createdById        String?      @map("createdById") // audit-readiness (full audit in Phase 19)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  vessel          Vessel         @relation(fields: [vesselId], references: [id])
  tugVessel       Vessel?       @relation("VoyageTug", fields: [tugVesselId], references: [id])
  bargeVessel     Vessel?       @relation("VoyageBarge", fields: [bargeVesselId], references: [id])
  originPort      Port           @relation("VoyageOrigin", fields: [originPortId], references: [id])
  destinationPort Port           @relation("VoyageDestination", fields: [destinationPortId], references: [id])
  createdBy       User?          @relation("VoyageCreated", fields: [createdById], references: [id])
  loadLists       LoadList[]
  manifests       Manifest[]
  billsOfLading   BillOfLading[] @relation("BillOfLadingVoyage")
  invoices        Invoice[]      @relation("InvoiceVoyage")
  jobs            Job[]          @relation("JobVoyage")

  @@index([voyageNumber])
  @@index([vesselId])
  @@index([tugVesselId])
  @@index([bargeVesselId])
  @@index([status])
  @@index([originPortId])
  @@index([destinationPortId])
  @@index([plannedDepartureAt])
  @@index([plannedArrivalAt])
  @@index([createdAt])

  legs VoyageDestination[] // destination legs with per-destination numbers
}

// Phase 2 - Voyage per-destination numbering (docs/current-plan
// 01-final-requirements.md:58-64, 04-final-data-model.md:44).
//
// One row per destination leg of a voyage, carrying the destination-scoped
// voyage number used in documents (e.g. 1/26, 2/26 - one sequence per
// destination per year). Single-destination voyages have exactly one leg;
// backfilled legs copy the parent voyageNumber so no historical number changes.
//
// NOTE: docs model a Voyage with a single destinationPortId and define no leg
// structure - this child model is the fallback recorded in the implementation
// log (deviation). Parent Voyage.voyageNumber (VOY-YYMM-#####) stays the
// system identifier; downstream Cargo/LoadList/ActualLoading/Discharge keep
// referencing Voyage.id unchanged (leg cutover is a separate task).
model VoyageDestination {
  id                String    @id @default(cuid())
  voyageId          String
  destinationPortId String
  legNumber         Int
  voyageNumber      String // destination-scoped document number, e.g. 1/26
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // soft delete (schema convention)

  voyage          Voyage @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  destinationPort Port   @relation("VoyageLegPort", fields: [destinationPortId], references: [id])

  @@unique([destinationPortId, voyageNumber])
  @@unique([voyageId, destinationPortId])
  @@index([voyageId])
  @@index([destinationPortId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 4 enums
// ---------------------------------------------------------------------------

// Operational lifecycle. READY additionally requires inspectionStatus=APPROVED.
enum CargoStatus {
  REGISTERED
  AT_YARD
  READY_FOR_LOADING
  LOADED // set by later phases; present here as forward-compatible state
  DELIVERED
  CANCELLED
}

// Physical cargo category. Small, controlled set (ADR-022).
enum CargoType {
  GENERAL
  VEHICLE
  HEAVY_LIFT
  CONTAINER
  BULK
  PROJECT
}

// Readiness field only — the Inspection workflow is Phase 5. Future rule:
// Cargo may be added to a Load List only when inspectionStatus = APPROVED.
enum InspectionStatus {
  PENDING
  BOOKED
  DONE
  FAILED
  NEEDS_REINSPECTION
}

// Readiness field only — Actual Loading is Phase 8. Established here so future
// loading operations can update cargo + inventory atomically.
enum LoadingStatus {
  NOT_LOADED
  LOADED
}

// Standardized weight unit (ADR-023). Mixing units within one cargo is not
// permitted at the record level.
enum WeightUnit {
  KG
  MT
}

// Current yard-inventory state.
enum InventoryStatus {
  IN_YARD
  RESERVED
}

// Phase 3: per-item selection state for LoadListItem.
// NOT_SELECTED = not yet picked for loading
// SELECTED = planned and selected for loading
// LOADED = confirmed loaded (FULL result in ActualLoadingItem)
// NOT_LOADED = confirmed not loaded (NOT_LOADED result in ActualLoadingItem)
enum LoadListItemSelectionStatus {
  NOT_SELECTED
  SELECTED
  LOADED
  NOT_LOADED
}

// ---------------------------------------------------------------------------
// Phase 6 enums
// ---------------------------------------------------------------------------

// Controlled vessel category (ADR-022-style). Only types relevant to the
// shipping operations are included; the set is an explicit, documented enum.
enum VesselType {
  CONTAINER
  BULK
  TANKER
  RORO
  GENERAL
  PROJECT
  OTHER
  TUG
  BARGE
  LANDING_CRAFT
}

// Voyage lifecycle (ADR-026). DRAFT -> SCHEDULED -> IN_PROGRESS -> COMPLETED;
// cancellation allowed from DRAFT and SCHEDULED. COMPLETED / CANCELLED are
// terminal historical states.
enum VoyageStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Phase 7: Load Planning & Load Lists
// ---------------------------------------------------------------------------
// LoadList represents a planned set of cargo for a specific Voyage.
// It is created in DRAFT state, then progresses through the loading lifecycle.
// Locked lifecycle (Phase 3): DRAFT → IN_PROGRESS → PARTIALLY_LOADED → COMPLETED → FINALIZED
// Items belong to LoadListItem with per-item selection state.
enum LoadListStatus {
  DRAFT
  IN_PROGRESS
  PARTIALLY_LOADED
  COMPLETED
  FINALIZED
  CANCELLED
}

// LoadList represents a planned set of cargo for a Voyage.
// Numbering: LL-YYMM-##### (auto-generated in service).
// Only DRAFT lists may be edited. FINALIZED/CANCELLED are terminal.
model LoadList {
  id             String         @id @default(cuid())
  loadListNumber String         @unique // auto LL-YYMM-#####
  voyageId       String         @map("voyageId")
  status         LoadListStatus @default(DRAFT)
  notes          String?
  createdById    String?        @map("createdById")
  finalizedById  String?        @map("finalizedById")
  cancelledById  String?        @map("cancelledById")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  finalizedAt    DateTime?      @map("finalizedAt")
  cancelledAt    DateTime?      @map("cancelledAt")
  deletedAt      DateTime?

  voyage        Voyage         @relation(fields: [voyageId], references: [id])
  items         LoadListItem[]
  actualLoading ActualLoading? @relation("ActualLoadingLoadList")
  createdBy     User?          @relation("LoadListCreatedBy", fields: [createdById], references: [id])
  finalizedBy   User?          @relation("LoadListFinalizedBy", fields: [finalizedById], references: [id])
  cancelledBy   User?          @relation("LoadListCancelledBy", fields: [cancelledById], references: [id])

  @@index([loadListNumber])
  @@index([voyageId])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

// LoadListItem links a Cargo to a LoadList with planned quantity.
// A cargo may appear only once per LoadList (enforced by unique constraint).
// Selection state lives on LoadListItem (Phase 3): NOT_SELECTED | SELECTED | LOADED | NOT_LOADED
// Cargo must have inspectionStatus = DONE to be eligible for loading (enforced in service).
model LoadListItem {
  id              String   @id @default(cuid())
  loadListId      String   @map("loadListId")
  cargoId         String   @map("cargoId")
  plannedQuantity Int?     @map("plannedQuantity") // optional; references Cargo.quantity
  sequence        Int? // display order within the list
  notes           String?
  selectionStatus LoadListItemSelectionStatus @default(NOT_SELECTED) // Phase 3: per-item selection state
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loadList          LoadList           @relation(fields: [loadListId], references: [id], onDelete: Cascade)
  cargo             Cargo              @relation(fields: [cargoId], references: [id])
  actualLoadingItem ActualLoadingItem? @relation("ActualLoadingItemLoadListItem")

  @@unique([loadListId, cargoId])
  @@index([loadListId])
  @@index([cargoId])
  @@index([sequence])
}

// ---------------------------------------------------------------------------
// Phase 8: Actual Loading
// ---------------------------------------------------------------------------
// ActualLoading represents the executed loading operation for a LoadList.
// Locked lifecycle (Phase 3): DRAFT → IN_PROGRESS → PARTIALLY_LOADED → COMPLETED → FINALIZED
// NOT_LOADED return-to-yard is handled by the service layer.
enum ActualLoadingStatus {
  DRAFT
  IN_PROGRESS
  PARTIALLY_LOADED
  COMPLETED
  FINALIZED
  CANCELLED
}

enum DischargeStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DischargeResult {
  NOT_DISCHARGED
  FULL
  PARTIAL
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// Result of loading a single cargo item.
enum LoadingResult {
  FULL
  PARTIAL
  NOT_LOADED
}

// ActualLoading represents the executed loading operation for a LoadList.
// It captures what was actually loaded vs planned, with full traceability.
model ActualLoading {
  id                  String              @id @default(cuid())
  actualLoadingNumber String              @unique // auto AL-YYMM-#####
  loadListId          String              @map("loadListId")
  status              ActualLoadingStatus @default(DRAFT)
  notes               String?
  createdById         String?             @map("createdById")
  completedById       String?             @map("completedById")
  cancelledById       String?             @map("cancelledById")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  completedAt         DateTime?           @map("completedAt")
  cancelledAt         DateTime?           @map("cancelledAt")
  deletedAt           DateTime?

  loadList    LoadList            @relation("ActualLoadingLoadList", fields: [loadListId], references: [id])
  discharge   Discharge?          @relation("DischargeActualLoading")
  items       ActualLoadingItem[]
  createdBy   User?               @relation("ActualLoadingCreatedBy", fields: [createdById], references: [id])
  completedBy User?               @relation("ActualLoadingCompletedBy", fields: [completedById], references: [id])
  cancelledBy User?               @relation("ActualLoadingCancelledBy", fields: [cancelledById], references: [id])

  @@unique([loadListId])
  @@index([actualLoadingNumber])
  @@index([loadListId])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

// ActualLoadingItem records the actual loaded quantity for a single cargo item.
// It links to the LoadListItem (planned) and records actual quantity loaded.
model ActualLoadingItem {
  id              String        @id @default(cuid())
  actualLoadingId String        @map("actualLoadingId")
  loadListItemId  String        @unique @map("loadListItemId")
  cargoId         String        @map("cargoId")
  actualQuantity  Int?          @map("actualQuantity")
  result          LoadingResult @default(NOT_LOADED)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  actualLoading ActualLoading  @relation(fields: [actualLoadingId], references: [id], onDelete: Cascade)
  loadListItem  LoadListItem   @relation("ActualLoadingItemLoadListItem", fields: [loadListItemId], references: [id], onDelete: Cascade)
  dischargeItem DischargeItem? @relation("DischargeItemSource")
  cargo         Cargo          @relation(fields: [cargoId], references: [id])

  @@unique([actualLoadingId, loadListItemId])
  @@index([actualLoadingId])
  @@index([loadListItemId])
  @@index([cargoId])
}

/// Phase 19 — discharge (unloading) at the port of destination. Mirror of Actual
/// Loading: what was physically loaded at POL must be physically discharged at POD.
model Discharge {
  id              String          @id @default(cuid())
  dischargeNumber String          @unique // auto DIS-YYMM-#####
  actualLoadingId String          @unique @map("actualLoadingId") // one live discharge per completed loading
  status          DischargeStatus @default(NOT_STARTED)
  notes           String?
  createdById     String?         @map("createdById")
  completedById   String?         @map("completedById")
  cancelledById   String?         @map("cancelledById")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completedAt     DateTime?       @map("completedAt")
  cancelledAt     DateTime?       @map("cancelledAt")
  deletedAt       DateTime?

  actualLoading ActualLoading   @relation("DischargeActualLoading", fields: [actualLoadingId], references: [id])
  items         DischargeItem[]
  createdBy     User?           @relation("DischargeCreatedBy", fields: [createdById], references: [id])
  completedBy   User?           @relation("DischargeCompletedBy", fields: [completedById], references: [id])
  cancelledBy   User?           @relation("DischargeCancelledBy", fields: [cancelledById], references: [id])

  @@index([dischargeNumber])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

model DischargeItem {
  id                  String          @id @default(cuid())
  dischargeId         String          @map("dischargeId")
  actualLoadingItemId String          @unique @map("actualLoadingItemId") // the loaded line this discharges
  cargoId             String          @map("cargoId")
  expectedQuantity    Int?            @map("expectedQuantity") // snapshot of loaded quantity
  dischargeQuantity   Int?            @map("dischargeQuantity")
  result              DischargeResult @default(NOT_DISCHARGED)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  discharge         Discharge         @relation(fields: [dischargeId], references: [id], onDelete: Cascade)
  actualLoadingItem ActualLoadingItem @relation("DischargeItemSource", fields: [actualLoadingItemId], references: [id], onDelete: Cascade)
  cargo             Cargo             @relation(fields: [cargoId], references: [id])

  @@index([dischargeId])
  @@index([cargoId])
  @@index([actualLoadingItemId])
}

/// Phase 20 — agent portal booking request (submitted by the agent company's
/// portal user, answered by staff; see ADR-040).
model BookingRequest {
  id                String        @id @default(cuid())
  bookingNumber     String        @unique // auto BRK-YYMM-#####
  customerId        String        @map("customerId") // the agent/forwarder company
  status            BookingStatus @default(PENDING)
  cargoDescription  String        @map("cargoDescription") // free text: commodity, containers…
  originPortId      String?       @map("originPortId")
  destinationPortId String?       @map("destinationPortId")
  requestedShipDate DateTime?     @map("requestedShipDate")
  containers        Int? // approximate unit count (TEU/containers/pallets)
  weightKg          Decimal?      @db.Decimal(18, 3)
  notes             String? // agent-side notes
  responseNote      String?       @map("responseNote") // staff answer on accept/decline
  submittedById     String?       @map("submittedById") // portal user who submitted
  handledById       String?       @map("handledById")
  handledAt         DateTime?     @map("handledAt")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  customer        Customer @relation("BookingAgent", fields: [customerId], references: [id])
  originPort      Port?    @relation("BookingOrigin", fields: [originPortId], references: [id])
  destinationPort Port?    @relation("BookingDestination", fields: [destinationPortId], references: [id])
  submittedBy     User?    @relation("BookingSubmittedBy", fields: [submittedById], references: [id])
  handledBy       User?    @relation("BookingHandledBy", fields: [handledById], references: [id])

  @@index([customerId])
  @@index([bookingNumber])
  @@index([status])
  @@index([createdAt])
  @@index([submittedById])
  @@map("booking_requests")
}

// ---------------------------------------------------------------------------
// Phase 9: Manifest (cargo manifest per voyage)
// ---------------------------------------------------------------------------
// A Manifest is the official cargo list for a voyage, built from cargo that
// was actually loaded (Phase 8 COMPLETED Actual Loading). It preserves the
// legacy duna manifest semantics (number per voyage, vessel/voyage snapshot,
// shipper/consignee/agent, cost breakdown, aggregated totals) on top of the
// new domain model. Totals are server-computed from items (legacy: SUM of BLs).
// Lifecycle: DRAFT -> SUBMITTED -> APPROVED | CANCELLED; DRAFT -> CANCELLED.
// APPROVED and CANCELLED are terminal.
enum ManifestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CANCELLED
}

model Manifest {
  id             String         @id @default(cuid())
  manifestNumber String         @unique // auto MAN-YYMM-#####
  voyageId       String         @map("voyageId")
  status         ManifestStatus @default(DRAFT)

  // Voyage/vessel snapshot (legacy stored vessel/voyage as strings)
  vesselName String  @map("vesselName")
  vesselImo  String? @map("vesselImo")
  polPortId  String  @map("polPortId") // port of loading (snapshot from voyage origin)
  podPortId  String  @map("podPortId") // port of discharge (snapshot from voyage destination)

  // Parties (Phase 2 cutover: party masters Shipper / Consignee / Agent;
  // previously Customer — values nulled by 20260929231625_party_cutover_party_fks)
  shipperId   String? @map("shipperId")
  consigneeId String? @map("consigneeId")
  agentId     String? @map("agentId")

  notifyParty String? @map("notifyParty") // legacy notify_party
  description String? // legacy descr

  // Cost breakdown (legacy decimals)
  gasCost      Decimal? @map("gasCost") @db.Decimal(18, 2)
  lashingCost  Decimal? @map("lashingCost") @db.Decimal(18, 2)
  shipperCost  Decimal? @map("shipperCost") @db.Decimal(18, 2)
  podCost      Decimal? @map("podCost") @db.Decimal(18, 2)
  polCost      Decimal? @map("polCost") @db.Decimal(18, 2)
  currencyCode String?  @map("currencyCode")

  // Aggregated totals — recomputed server-side from items on every write.
  totalWeight   Decimal @default(0) @map("totalWeight") @db.Decimal(18, 3)
  totalQuantity Int     @default(0) @map("totalQuantity")
  totalPackages Int     @default(0) @map("totalPackages")

  cancelReason String? @map("cancelReason") // required on cancellation
  notes        String?

  createdById   String? @map("createdById")
  submittedById String? @map("submittedById")
  approvedById  String? @map("approvedById")
  cancelledById String? @map("cancelledById")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime? @map("submittedAt")
  approvedAt  DateTime? @map("approvedAt")
  cancelledAt DateTime? @map("cancelledAt")
  deletedAt   DateTime?

  voyage        Voyage         @relation(fields: [voyageId], references: [id])
  polPort       Port           @relation("ManifestPol", fields: [polPortId], references: [id])
  podPort       Port           @relation("ManifestPod", fields: [podPortId], references: [id])
  shipper       Shipper?       @relation("ManifestShipper", fields: [shipperId], references: [id])
  consignee     Consignee?     @relation("ManifestConsignee", fields: [consigneeId], references: [id])
  agent         Agent?         @relation("ManifestAgent", fields: [agentId], references: [id])
  items         ManifestItem[]
  billsOfLading BillOfLading[] @relation("BillOfLadingManifest")
  invoices      Invoice[]      @relation("InvoiceManifest")
  createdBy     User?          @relation("ManifestCreatedBy", fields: [createdById], references: [id])
  submittedBy   User?          @relation("ManifestSubmittedBy", fields: [submittedById], references: [id])
  approvedBy    User?          @relation("ManifestApprovedBy", fields: [approvedById], references: [id])
  cancelledBy   User?          @relation("ManifestCancelledBy", fields: [cancelledById], references: [id])

  // One LIVE manifest per voyage is enforced at the application level
  // (service checks voyageId + deletedAt IS NULL). A DB-level @@unique would
  // conflict with soft-delete: a deleted draft would block the voyage forever.
  @@index([voyageId])
  @@index([manifestNumber])
  @@index([status])
  @@index([polPortId])
  @@index([podPortId])
  @@index([shipperId])
  @@index([consigneeId])
  @@index([createdAt])
  @@index([createdById])
  @@map("manifests")
}

model ManifestItem {
  id          String   @id @default(cuid())
  manifestId  String   @map("manifestId")
  cargoId     String   @map("cargoId")
  sequence    Int
  blNumber    String?  @map("blNumber") // legacy B/L number; filled by the future B/L module
  // Cargo snapshot at time of manifesting (manifest is a legal document — frozen values)
  weight      Decimal? @db.Decimal(18, 3)
  quantity    Int?
  packages    Int?
  packageType String?  @map("packageType")
  notes       String?

  actualLoadingItemId String? @unique @map("actualLoadingItemId") // traceability to Phase 8

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  cargo    Cargo    @relation(fields: [cargoId], references: [id])

  billsOfLadingItems BillOfLadingItem[] @relation("BillOfLadingItemManifestItem")

  @@unique([manifestId, cargoId])
  @@index([manifestId])
  @@index([cargoId])
  @@index([sequence])
  @@map("manifest_items")
}

// ---------------------------------------------------------------------------
// Phase 10: Bill of Lading (B/L)
// ---------------------------------------------------------------------------
// A Bill of Lading is a transport document issued against an APPROVED Manifest.
// It groups a subset of the manifest's cargo lines into one legal document
// (one BL per consignee / cargo lot) with frozen line snapshots — mirrors the
// legacy duna BL concept. Issuing stamps ManifestItem.blNumber with the BL
// number (the link the manifest UI already shows).
// Lifecycle: DRAFT -> ISSUED | CANCELLED; DRAFT -> CANCELLED.
// ISSUED is frozen; only cancellation remains.
enum BlStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum BlType {
  MASTER
  HOUSE
}

enum FreightTerms {
  PREPAID
  COLLECT
}

model BillOfLading {
  id         String   @id @default(cuid())
  billNumber String   @unique // auto BOL-YYMM-#####
  manifestId String   @map("manifestId")
  voyageId   String   @map("voyageId") // denormalized via manifest for queries
  status     BlStatus @default(DRAFT)
  billType   BlType   @default(HOUSE)

  // Vessel snapshot copied from the manifest at creation
  vesselName String  @map("vesselName")
  vesselImo  String? @map("vesselImo")

  // Parties (defaulted from the manifest, overridable per document)
  shipperId   String? @map("shipperId")
  consigneeId String? @map("consigneeId")
  notifyParty String? @map("notifyParty")

  // Commercial terms
  freightTerms  FreightTerms? @map("freightTerms")
  carrierName   String?       @map("carrierName")
  placeOfIssue  String?       @map("placeOfIssue")
  dateOfIssue   DateTime?     @map("dateOfIssue")
  originals     Int? // number of original B/Ls issued
  freightAmount Decimal?      @map("freightAmount") @db.Decimal(18, 2)
  currencyCode  String?       @map("currencyCode")

  // Header-level cargo description ("said to contain")
  goodsDescription String? @map("goodsDescription")
  shipmentMarks    String? @map("shipmentMarks")

  // Aggregated totals — recomputed server-side from items on every write.
  totalPackages    Int     @default(0) @map("totalPackages")
  totalGrossWeight Decimal @default(0) @map("totalGrossWeight") @db.Decimal(18, 3)
  totalVolume      Decimal @default(0) @map("totalVolume") @db.Decimal(18, 3)

  cancelReason String? @map("cancelReason") // required on cancellation
  notes        String?

  createdById   String? @map("createdById")
  issuedById    String? @map("issuedById")
  cancelledById String? @map("cancelledById")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  issuedAt    DateTime? @map("issuedAt")
  cancelledAt DateTime? @map("cancelledAt")
  deletedAt   DateTime?

  manifest       Manifest           @relation("BillOfLadingManifest", fields: [manifestId], references: [id])
  voyage         Voyage             @relation("BillOfLadingVoyage", fields: [voyageId], references: [id])
  shipper        Shipper?           @relation("BillShipper", fields: [shipperId], references: [id])
  consignee      Consignee?         @relation("BillConsignee", fields: [consigneeId], references: [id])
  items          BillOfLadingItem[]
  invoices       Invoice[]          @relation("InvoiceBill")
  deliveryOrders DeliveryOrder[]    @relation("DeliveryOrderBill")
  releaseOrders  ReleaseOrder[]     @relation("ReleaseOrderBill")
  createdBy      User?              @relation("BillCreatedBy", fields: [createdById], references: [id])
  issuedBy       User?              @relation("BillIssuedBy", fields: [issuedById], references: [id])
  cancelledBy    User?              @relation("BillCancelledBy", fields: [cancelledById], references: [id])

  // A manifest may hold many BLs; a manifest line may belong to at most one
  // LIVE (non-deleted, non-cancelled) BL — enforced at application level so
  // cancellation/soft-delete releases the line back (same pattern as
  // Manifest.voyageId: soft-delete conflicts with a DB @@unique).
  @@index([manifestId])
  @@index([voyageId])
  @@index([status])
  @@index([shipperId])
  @@index([consigneeId])
  @@index([createdAt])
  @@index([createdById])
  @@map("bills_of_lading")
}

model BillOfLadingItem {
  id             String @id @default(cuid())
  billOfLadingId String @map("billOfLadingId")
  manifestItemId String @map("manifestItemId")
  cargoId        String @map("cargoId")
  sequence       Int

  // Frozen snapshot for the printed document (defaults from manifest item)
  goodsDescription String?  @map("goodsDescription")
  marksAndNumbers  String?  @map("marksAndNumbers")
  packages         Int?
  packageType      String?  @map("packageType")
  grossWeight      Decimal? @map("grossWeight") @db.Decimal(18, 3)
  volume           Decimal? @db.Decimal(18, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billOfLading BillOfLading @relation(fields: [billOfLadingId], references: [id], onDelete: Cascade)
  manifestItem ManifestItem @relation("BillOfLadingItemManifestItem", fields: [manifestItemId], references: [id])
  cargo        Cargo        @relation("BillOfLadingItemCargo", fields: [cargoId], references: [id])

  @@index([billOfLadingId])
  @@index([manifestItemId])
  @@index([cargoId])
  @@map("bills_of_lading_items")
}

// ---------------------------------------------------------------------------
// Phase 11: Invoice (فاکتور)
// ---------------------------------------------------------------------------
// An Invoice is issued to a customer (bill-to), optionally anchored to the
// shipping documents that justify it (Manifest and/or B/L — both optional,
// mirroring the legacy duna invoice which linked to bl/manifest optionally).
// Lines are free-form description + amount (legacy `items` table shape).
// Lifecycle: DRAFT -> ISSUED | CANCELLED; DRAFT -> CANCELLED.
// ISSUED is frozen (cancel only). `paidAmount` is maintained by the
// finance module (Phase 12 vouchers/Fin); PAID is derived at read time
// (paidAmount >= totalAmount), not a stored status — legacy stored
// PAID/UNPAID but mutated it through Fin records anyway.
enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // auto INV-YYMM-#####
  customerId    String        @map("customerId") // bill-to counterparty
  status        InvoiceStatus @default(DRAFT)

  // Optional document anchors (legacy bl_id / manifest_id)
  manifestId     String? @map("manifestId")
  billOfLadingId String? @map("billOfLadingId")
  // Denormalized from bill/manifest for fast list filters (nullable).
  voyageId       String? @map("voyageId")

  title       String? // legacy title (free heading on the printed invoice)
  description String? // legacy todescr (to-description)

  currencyCode String    @default("USD") @map("currencyCode") // ISO 4217
  issueDate    DateTime? @map("issueDate")
  dueDate      DateTime? @map("dueDate")

  // Money — subtotal recomputed from items (SUM line amount = qty x unit price),
  // then totalAmount = subtotal - discountAmount + taxAmount. paidAmount is
  // maintained by the finance module (Phase 12).
  subtotal       Decimal @default(0) @map("subtotal") @db.Decimal(18, 2)
  taxRate        Decimal @default(0) @map("taxRate") @db.Decimal(5, 2) // percent 0..100
  taxAmount      Decimal @default(0) @map("taxAmount") @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @map("discountAmount") @db.Decimal(18, 2)
  totalAmount    Decimal @default(0) @map("totalAmount") @db.Decimal(18, 2)
  paidAmount     Decimal @default(0) @map("paidAmount") @db.Decimal(18, 2)

  cancelReason String? @map("cancelReason") // required on cancellation
  notes        String?

  createdById   String? @map("createdById")
  issuedById    String? @map("issuedById")
  cancelledById String? @map("cancelledById")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  issuedAt    DateTime? @map("issuedAt")
  cancelledAt DateTime? @map("cancelledAt")
  deletedAt   DateTime?

  customer          Customer?     @relation("InvoiceCustomer", fields: [customerId], references: [id])
  manifest          Manifest?     @relation("InvoiceManifest", fields: [manifestId], references: [id])
  billOfLading      BillOfLading? @relation("InvoiceBill", fields: [billOfLadingId], references: [id])
  voyage            Voyage?       @relation("InvoiceVoyage", fields: [voyageId], references: [id])
  items             InvoiceItem[]
  convertedProforma Proforma?     @relation("ProformaConvertedInvoice")
  vouchers          Voucher[]     @relation("VoucherInvoice")
  createdBy         User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  issuedBy          User?         @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])
  cancelledBy       User?         @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])

  @@index([customerId])
  @@index([manifestId])
  @@index([billOfLadingId])
  @@index([voyageId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([createdById])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoiceId")
  sequence    Int
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @map("unitPrice") @db.Decimal(18, 2)
  // Line total = quantity * unitPrice, maintained server-side on every write.
  amount      Decimal @default(0) @db.Decimal(18, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([sequence])
  @@map("invoice_items")
}

// ─── Phase 14: Proforma invoices (quotes) ─────────────────────────────────────
// A proforma is a pre-invoice money document: same line/totals math as Invoice
// but zero financial effect (no paidAmount, vouchers cannot link). It can be
// converted ONCE into a real DRAFT invoice (linkedInvoiceId guard), copying
// header + items; the proforma then remains ISSUED as the quote of record.
enum ProformaStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model Proforma {
  id             String         @id @default(cuid())
  proformaNumber String         @unique // auto PRF-YYMM-#####
  customerId     String         @map("customerId") // bill-to counterparty
  status         ProformaStatus @default(DRAFT)

  title       String? // free heading on the printed quote
  description String?

  currencyCode String    @default("USD") @map("currencyCode") // ISO 4217
  issueDate    DateTime? @map("issueDate")
  validUntil   DateTime? @map("validUntil") // quote expiry (proforma-specific)

  // Same math as Invoice: subtotal = SUM(items.amount),
  // taxAmount = (subtotal - discountAmount) * taxRate / 100,
  // totalAmount = subtotal - discountAmount + taxAmount.
  subtotal       Decimal @default(0) @map("subtotal") @db.Decimal(18, 2)
  taxRate        Decimal @default(0) @map("taxRate") @db.Decimal(5, 2) // percent 0..100
  taxAmount      Decimal @default(0) @map("taxAmount") @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @map("discountAmount") @db.Decimal(18, 2)
  totalAmount    Decimal @default(0) @map("totalAmount") @db.Decimal(18, 2)

  // One-time conversion link (ADR-034): set to the created invoice's id.
  linkedInvoiceId String? @unique @map("linkedInvoiceId")

  cancelReason String? @map("cancelReason") // required on cancellation
  notes        String?

  createdById   String? @map("createdById")
  issuedById    String? @map("issuedById")
  cancelledById String? @map("cancelledById")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  issuedAt    DateTime? @map("issuedAt")
  cancelledAt DateTime? @map("cancelledAt")
  deletedAt   DateTime? @map("deletedAt")

  customer    Customer?      @relation("ProformaCustomer", fields: [customerId], references: [id])
  invoice     Invoice?       @relation("ProformaConvertedInvoice", fields: [linkedInvoiceId], references: [id])
  quotation   Quotation?     @relation("QuotationConvertedProforma")
  items       ProformaItem[]
  createdBy   User?          @relation("ProformaCreatedBy", fields: [createdById], references: [id])
  issuedBy    User?          @relation("ProformaIssuedBy", fields: [issuedById], references: [id])
  cancelledBy User?          @relation("ProformaCancelledBy", fields: [cancelledById], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([createdAt])
  @@map("proformas")
}

model ProformaItem {
  id          String  @id @default(cuid())
  proformaId  String  @map("proformaId")
  sequence    Int
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @map("unitPrice") @db.Decimal(18, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2) // qty * unitPrice, server-side

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proforma Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId])
  @@index([sequence])
  @@map("proforma_items")
}

// ─── Phase 15: Quotations (price quotes — top of the commercial chain) ────────
// A quotation answers a customer inquiry with a binding-until-expiry price.
// Same money math as Invoice/Proforma. Lifecycle:
//   DRAFT -> SENT -> ACCEPTED | REJECTED | CANCELLED  (DRAFT may also CANCELLED)
// ACCEPTED quotations convert ONCE into a DRAFT proforma, completing the
// legacy-free chain Quote -> Proforma -> Invoice (ADR-035).
enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique // auto QT-YYMM-#####
  customerId      String          @map("customerId") // quoted-for counterparty
  status          QuotationStatus @default(DRAFT)

  title       String? // free heading on the printed quote
  description String?

  currencyCode String    @default("USD") @map("currencyCode") // ISO 4217
  issueDate    DateTime? @map("issueDate")
  validUntil   DateTime? @map("validUntil") // quote expiry

  // Same math as Invoice: subtotal = SUM(items.amount),
  // taxAmount = (subtotal - discountAmount) * taxRate / 100,
  // totalAmount = subtotal - discountAmount + taxAmount.
  subtotal       Decimal @default(0) @map("subtotal") @db.Decimal(18, 2)
  taxRate        Decimal @default(0) @map("taxRate") @db.Decimal(5, 2) // percent 0..100
  taxAmount      Decimal @default(0) @map("taxAmount") @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @map("discountAmount") @db.Decimal(18, 2)
  totalAmount    Decimal @default(0) @map("totalAmount") @db.Decimal(18, 2)

  // One-time conversion link (ADR-035): set to the created proforma's id.
  linkedProformaId String? @unique @map("linkedProformaId")

  rejectReason String? @map("rejectReason") // required on rejection
  cancelReason String? @map("cancelReason") // required on cancellation
  notes        String?

  createdById   String? @map("createdById")
  sentById      String? @map("sentById")
  acceptedById  String? @map("acceptedById")
  rejectedById  String? @map("rejectedById")
  cancelledById String? @map("cancelledById")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime? @map("sentAt")
  acceptedAt  DateTime? @map("acceptedAt")
  rejectedAt  DateTime? @map("rejectedAt")
  cancelledAt DateTime? @map("cancelledAt")
  deletedAt   DateTime? @map("deletedAt")

  customer    Customer?       @relation("QuotationCustomer", fields: [customerId], references: [id])
  proforma    Proforma?       @relation("QuotationConvertedProforma", fields: [linkedProformaId], references: [id])
  items       QuotationItem[]
  createdBy   User?           @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  sentBy      User?           @relation("QuotationSentBy", fields: [sentById], references: [id])
  acceptedBy  User?           @relation("QuotationAcceptedBy", fields: [acceptedById], references: [id])
  rejectedBy  User?           @relation("QuotationRejectedBy", fields: [rejectedById], references: [id])
  cancelledBy User?           @relation("QuotationCancelledBy", fields: [cancelledById], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String  @map("quotationId")
  sequence    Int
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @map("unitPrice") @db.Decimal(18, 2)
  // Line total = quantity * unitPrice, maintained server-side on every write.
  amount      Decimal @default(0) @db.Decimal(18, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([sequence])
  @@map("quotation_items")
}

// ===========================================================================
// Phase 16 — HR & Payroll (ADR-036)
// ===========================================================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum SalaryStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model Employee {
  id           String         @id @default(cuid())
  code         String         @unique // auto EMP-##### (server-generated when omitted)
  name         String
  nationalId   String?        @map("nationalId")
  position     String?
  phone        String?
  email        String?
  hireDate     DateTime?      @map("hireDate") @db.Date
  baseSalary   Decimal        @default(0) @map("baseSalary") @db.Decimal(18, 2)
  currencyCode String         @default("USD") @map("currencyCode")
  status       EmployeeStatus @default(ACTIVE)
  notes        String?

  createdById String? @map("createdById")
  createdBy   User?   @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  salaryRecords SalaryRecord[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deletedAt")

  @@map("employees")
}

model SalaryRecord {
  id           String   @id @default(cuid())
  recordNumber String   @unique // SAL-YYMM-#####
  employeeId   String   @map("employeeId")
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  year   Int
  month  Int // 1..12
  status SalaryStatus @default(DRAFT)

  base         Decimal @default(0) @db.Decimal(18, 2)
  additions    Decimal @default(0) @db.Decimal(18, 2) // bonus/OT/allowances
  deductions   Decimal @default(0) @db.Decimal(18, 2) // insurance/tax/advances
  net          Decimal @default(0) @db.Decimal(18, 2) // base + additions - deductions, server-computed
  currencyCode String  @default("USD") @map("currencyCode")

  // Payment trace lives on the record itself; Voucher/ledger stays customer-only (ADR-036).
  paymentMethod VoucherMethod? @map("paymentMethod")
  paymentRef    String?        @map("paymentRef") // bank transfer / receipt trace

  approvedById String?   @map("approvedById")
  approvedBy   User?     @relation("SalaryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime? @map("approvedAt")

  paidById String?   @map("paidById")
  paidBy   User?     @relation("SalaryPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt   DateTime? @map("paidAt")

  cancelledById String?   @map("cancelledById")
  cancelledBy   User?     @relation("SalaryCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime? @map("cancelledAt")
  cancelReason  String?   @map("cancelReason")

  notes       String?
  createdById String? @map("createdById")
  createdBy   User?   @relation("SalaryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deletedAt")

  @@unique([employeeId, year, month]) // one payslip per employee per month
  @@index([year, month])
  @@index([status])
  @@map("salary_records")
}

// ─── Phase 12: Finance — vouchers (receipt/payment) + derived ledger ──────────
// Modernized legacy Fin (fins): a voucher is a directly-POSTED money document
// against a customer, optionally settling an invoice. RECEIPT increases the
// invoice paidAmount, PAYMENT decreases it (refund); cancel/delete recomputes
// paidAmount from live vouchers. The ledger/statement is derived (no table):
// customer statement = ISSUED invoices (charge) + POSTED vouchers (settlement).
enum VoucherType {
  RECEIPT // money in from customer (legacy "Received")
  PAYMENT // money out to customer: refund/credit (legacy "Sales/Payment")
}

enum VoucherMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum VoucherStatus {
  POSTED
  CANCELLED
}

model Voucher {
  id            String        @id @default(cuid())
  voucherNumber String        @unique // auto RCP-YYMM-##### / PMT-YYMM-##### per type
  type          VoucherType
  status        VoucherStatus @default(POSTED)
  customerId    String        @map("customerId") // counterparty (legacy user_id)
  invoiceId     String?       @map("invoiceId") // optional settlement document
  voyageId      String?       @map("voyageId") // denormalized from invoice (fast filters, no FK)

  amount       Decimal       @db.Decimal(18, 2) // always positive; sign comes from type
  currencyCode String        @default("USD") @map("currencyCode") // must match invoice currency when linked
  exchangeRate Decimal       @default(1) @db.Decimal(10, 4)
  method       VoucherMethod @default(BANK_TRANSFER)
  reference    String? // cheque / transfer trace number
  description  String? // ledger line description
  note         String?
  voucherDate  DateTime      @map("voucherDate") // value date (legacy fromdate)

  cancelReason String? @map("cancelReason") // required on cancellation

  createdById   String? @map("createdById")
  cancelledById String? @map("cancelledById")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime? @map("cancelledAt")
  deletedAt   DateTime?

  customer    Customer? @relation("VoucherCustomer", fields: [customerId], references: [id])
  invoice     Invoice?  @relation("VoucherInvoice", fields: [invoiceId], references: [id])
  createdBy   User?     @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?     @relation("VoucherCancelledBy", fields: [cancelledById], references: [id])

  @@index([customerId])
  @@index([invoiceId])
  @@index([voyageId])
  @@index([type])
  @@index([status])
  @@index([voucherDate])
  @@index([createdAt])
  @@index([createdById])
  @@map("vouchers")
}

// ─── Phase 13: Delivery Order (D/O) & Release Order (R/O) ────────────────────
// Modernized legacy DeliveryOrder/ReleaseOrder. D/O = cargo hand-over permit
// against a B/L (recipient pickup); R/O = gate/customs release permit. The
// money rule: an R/O requires the linked invoice(s) fully paid unless an
// authorized override with reason is recorded ("no money, no cargo").
enum DeliveryOrderStatus {
  ISSUED
  CANCELLED
}

model DeliveryOrder {
  id             String              @id @default(cuid())
  docNumber      String              @unique // DO-YYMM-#####
  billOfLadingId String              @map("billOfLadingId")
  status         DeliveryOrderStatus @default(ISSUED)
  issueDate      DateTime            @default(now()) @map("issueDate")
  /// Name/ID of the party physically receiving the cargo (legacy recipient).
  recipient      String
  recipientId    String?             @map("recipientId") // optional customer link
  vehiclePlate   String?             @map("vehiclePlate")
  notes          String?
  cancelReason   String?             @map("cancelReason")
  cancelledById  String?             @map("cancelledById")
  cancelledAt    DateTime?           @map("cancelledAt")
  createdById    String              @map("createdById")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  billOfLading      BillOfLading @relation("DeliveryOrderBill", fields: [billOfLadingId], references: [id])
  recipientCustomer Customer?    @relation("DeliveryOrderRecipient", fields: [recipientId], references: [id])
  createdBy         User         @relation("DeliveryOrderCreatedBy", fields: [createdById], references: [id])
  cancelledBy       User?        @relation("DeliveryOrderCancelledBy", fields: [cancelledById], references: [id])

  @@index([billOfLadingId])
  @@index([status])
  @@index([issueDate])
  @@map("delivery_orders")
}

model ReleaseOrder {
  id                String              @id @default(cuid())
  docNumber         String              @unique // RO-YYMM-#####
  billOfLadingId    String              @map("billOfLadingId")
  status            DeliveryOrderStatus @default(ISSUED)
  releaseDate       DateTime            @default(now()) @map("releaseDate")
  /// True when issued despite unpaid invoices — requires reason (audit).
  financialOverride Boolean             @default(false) @map("financialOverride")
  overrideReason    String?             @map("overrideReason")
  notes             String?
  cancelReason      String?             @map("cancelReason")
  cancelledById     String?             @map("cancelledById")
  cancelledAt       DateTime?           @map("cancelledAt")
  createdById       String              @map("createdById")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  billOfLading BillOfLading @relation("ReleaseOrderBill", fields: [billOfLadingId], references: [id])
  createdBy    User         @relation("ReleaseOrderCreatedBy", fields: [createdById], references: [id])
  cancelledBy  User?        @relation("ReleaseOrderCancelledBy", fields: [cancelledById], references: [id])

  @@index([billOfLadingId])
  @@index([status])
  @@index([releaseDate])
  @@map("release_orders")
}

enum LetterDirection {
  INCOMING
  OUTGOING
}

enum LetterStatus {
  DRAFT
  SENT
  RECEIVED
  ARCHIVED
}

/// Correspondence register (Phase 17, ADR-037). INCOMING letters are created as
/// RECEIVED; OUTGOING follow DRAFT -> SENT. Both archive from their active state
/// (ARCHIVED terminal). Replies thread through replyToId — any letter may spawn
/// multiple replies; editing content is DRAFT-only. No file attachments yet
/// (notes carry the reference), no per-agent portal coupling until Phase 20.
model Letter {
  id           String          @id @default(cuid())
  letterNumber String          @unique @map("letterNumber") // LET-YYMM-#####
  direction    LetterDirection
  status       LetterStatus    @default(DRAFT)
  letterDate   DateTime        @map("letterDate")
  subject      String          @db.VarChar(255)
  body         String?         @db.Text
  refNumber    String?         @map("refNumber") @db.VarChar(100)
  fromContact  String?         @map("fromContact") @db.VarChar(160)
  toContact    String?         @map("toContact") @db.VarChar(160)
  customerId   String?         @map("customerId")
  replyToId    String?         @map("replyToId")
  notes        String?         @db.VarChar(500)
  sentById     String?         @map("sentById")
  sentAt       DateTime?       @map("sentAt")
  archivedById String?         @map("archivedById")
  archivedAt   DateTime?       @map("archivedAt")
  createdById  String?         @map("createdById")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?       @map("deletedAt")

  customer   Customer? @relation("LetterCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  replyTo    Letter?   @relation("LetterReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Letter[]  @relation("LetterReply")
  createdBy  User?     @relation("LetterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentBy     User?     @relation("LetterSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  archivedBy User?     @relation("LetterArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([direction])
  @@index([letterDate])
  @@index([customerId])
  @@index([replyToId])
  @@map("letters")
}

enum JobStatus {
  DRAFT
  OPEN
  COMPLETED
  CANCELLED
}

enum JobItemKind {
  COST
  INCOME
}

/// Job & costing (Phase 18, ADR-038). A job groups the operational work of one
/// shipment (port call, transport, clearance); cost/income lines are tracked in
/// the job currency. profit = sum(INCOME) - sum(COST), computed server-side.
model Job {
  id            String    @id @default(cuid())
  jobNumber     String    @unique @map("jobNumber") // JOB-YYMM-#####
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  customerId    String?   @map("customerId")
  voyageId      String?   @map("voyageId")
  jobType       String?   @map("jobType") @db.VarChar(60)
  status        JobStatus @default(DRAFT)
  currencyCode  String    @default("USD") @map("currencyCode") @db.VarChar(3)
  openingDate   DateTime  @default(now()) @map("openingDate")
  completedAt   DateTime? @map("completedAt")
  completedById String?   @map("completedById")
  cancelledAt   DateTime? @map("cancelledAt")
  cancelledById String?   @map("cancelledById")
  cancelReason  String?   @map("cancelReason") @db.VarChar(500)
  notes         String?   @db.VarChar(500)
  createdById   String?   @map("createdById")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? @map("deletedAt")

  customer    Customer?     @relation("JobCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  voyage      Voyage?       @relation("JobVoyage", fields: [voyageId], references: [id], onDelete: SetNull)
  items       JobCostItem[] @relation("JobItems")
  createdBy   User?         @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy User?         @relation("JobCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  cancelledBy User?         @relation("JobCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([customerId])
  @@index([voyageId])
  @@index([openingDate])
  @@map("jobs")
}

model JobCostItem {
  id          String      @id @default(cuid())
  jobId       String      @map("jobId")
  kind        JobItemKind
  category    String?     @db.VarChar(60)
  description String      @db.VarChar(255)
  amount      Decimal     @db.Decimal(18, 2)
  itemDate    DateTime?   @map("itemDate")
  notes       String?     @db.VarChar(255)
  createdAt   DateTime    @default(now())

  job Job @relation("JobItems", fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([kind])
  @@map("job_cost_items")
}

// ============================================================================
// PHASE 1 INFRASTRUCTURE — added 2026-09-21
// Tables: NumberingSequence, AuditLog, FileAttachment, DocumentTemplate,
//         DocumentTemplateVersion
// See: docs/ai-audit/migration-safety.md
// See: docs/ai-audit/06.5-technical-decision-lock.md (decisions 9,16,17,18)
// ============================================================================

/// Configurable document numbering sequence (ADR-008).
/// Supports global, destination-scoped, year, and year-period scoping.
/// Allocation is performed inside a transaction with row locking in the
/// NumberingService; the DB unique constraint on `name` protects against
/// duplicate logical sequences.
model NumberingSequence {
  id           String   @id @default(cuid())
  name         String   @unique @map("name")
  documentType String   @map("documentType")
  scopeType    String   @map("scopeType") // GLOBAL | DESTINATION | YEAR | YEAR_PERIOD
  scopeValue   String?
  prefix       String   @default("") @map("prefix")
  padding      Int      @default(5) @map("padding")
  format       String   @default("{prefix}{sequence}") @map("format")
  nextSequence Int      @default(1) @map("nextSequence")
  period       String   @default("YYYY") @map("period") // YYYY | YY | YYYYMM | QUARTER
  companyId    String?
  isActive     Boolean  @default(true) @map("isActive")
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @updatedAt @map("updatedAt")

  @@index([documentType, scopeType, scopeValue, isActive])
  @@index([isActive])
  @@map("NumberingSequence")
}

/// Append-only audit log (ADR-010).
/// Written in the same transaction as the mutation. Not editable through
/// normal application CRUD. `id` + `timestamp` is the PK so the same actor
/// can record multiple events for the same entity over time.
model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now()) @map("timestamp")
  actorId     String   @map("actorId")
  actorEmail  String   @map("actorEmail")
  action      String   @map("action")
  entityType  String   @map("entityType")
  entityId    String   @map("entityId")
  beforeData  Json?    @map("beforeData")
  afterData   Json?    @map("afterData")
  metadata    Json     @default("{}") @map("metadata")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now()) @map("createdAt")

  @@index([entityType, entityId, timestamp])
  @@map("AuditLog")
}

/// Generic file attachment infrastructure (Phase 1).
/// Storage abstraction with local dev adapter and S3-compatible production
/// adapter interface. Access control is enforced in the service layer.
model FileAttachment {
  id             String   @id @default(cuid())
  entityType     String   @map("entityType")
  entityId       String   @map("entityId")
  category       String   @map("category")
  storageAdapter String   @default("local") @map("storageAdapter") // local | s3
  storageKey     String   @map("storageKey")
  filename       String   @map("filename")
  mimeType       String   @map("mimeType")
  size           BigInt   @default(0) @map("size")
  contentType    String?
  uploadedById   String?  @map("uploadedById")
  uploadedAt     DateTime @default(now()) @map("uploadedAt")
  deletedAt      DateTime? @map("deletedAt")
  createdAt      DateTime @default(now()) @map("createdAt")
  updatedAt      DateTime @updatedAt @map("updatedAt")

  @@index([entityType, entityId])
  @@index([category])
  @@index([uploadedById])
  @@index([storageAdapter, storageKey])
  @@index([deletedAt])
  @@map("FileAttachment")
}

/// Document template registry (ADR-009).
/// One logical template per document type; the active version is tracked
/// in `currentVersionId` for fast lookup.
model DocumentTemplate {
  id              String   @id @default(cuid())
  documentType    String   @map("documentType")
  name            String   @unique @map("name")
  description     String?
  format          String   @default("PDF") @map("format") // PDF | EXCEL | PDF_EXCEL
  storageAdapter  String   @default("local") @map("storageAdapter")
  isActive        Boolean  @default(true) @map("isActive")
  currentVersionId String? @map("currentVersionId")
  createdById     String?  @map("createdById")
  createdAt       DateTime @default(now()) @map("createdAt")
  updatedAt       DateTime @updatedAt @map("updatedAt")
  deletedAt       DateTime? @map("deletedAt")

  versions DocumentTemplateVersion[] @relation("TemplateVersions")

  @@index([documentType])
  @@index([documentType, isActive])
  @@map("DocumentTemplate")
}

/// Versioned document template content reference (ADR-009).
model DocumentTemplateVersion {
  id              String   @id @default(cuid())
  templateId      String   @map("templateId")
  version         Int      @map("version")
  label           String?
  storageKey      String   @map("storageKey")
  storageAdapter  String   @default("local") @map("storageAdapter")
  mimeType        String   @map("mimeType")
  size            BigInt   @default(0) @map("size")
  isActive        Boolean  @default(false) @map("isActive")
  createdAt       DateTime @default(now()) @map("createdAt")
  updatedAt       DateTime @updatedAt @map("updatedAt")

  template DocumentTemplate @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId])
  @@map("DocumentTemplateVersion")
}
