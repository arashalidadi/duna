{
  "name": "shipping-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Shipping Operations & Accounting ERP - Phase 1: Architecture & Project Bootstrap",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream run dev",
    "dev:web": "pnpm --filter @shipping/web dev",
    "dev:api": "pnpm --filter @shipping/api dev",
    "build": "pnpm run build:api && pnpm run build:web",
    "build:web": "pnpm --filter @shipping/web build",
    "build:api": "pnpm db:generate && pnpm --filter @shipping/config --filter @shipping/shared run build && pnpm --filter @shipping/api build",
    "check:api:build": "node scripts/check-api-build.mjs verify",
    "setup:fresh": "node scripts/fresh/setup.cjs",
    "test:fast": "node --test scripts/fresh/*.test.cjs apps/api/scripts/phase11-server-workflow.test.cjs && pnpm check:seed-safety && pnpm --filter @shipping/web test",
    "test:integration": "node scripts/fresh/setup.cjs --integration",
    "test:e2e:health": "node scripts/fresh/setup.cjs --health",
    "phase12:apply": "node scripts/phase12/server-workflow.cjs apply",
    "phase12:test": "node scripts/phase12/server-workflow.cjs test",
    "start": "pnpm run start -r",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "pretest": "pnpm --filter @shipping/config --filter @shipping/shared run build",
    "test": "pnpm -r run test",
    "test:watch": "pnpm run test:watch -r",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "SEED_DEMO_DATA=true tsx prisma/seed.ts",
    "check:seed-safety": "node scripts/check-seed-safety.mjs",
    "test:pagination": "tsx apps/web/scripts/test-pagination.ts",
    "test:seed-safety": "tsx scripts/test-seed-safety.ts",
    "test:e2e-baseline": "tsx scripts/record-e2e-baseline.ts",
    "test:e2e-baseline:unit": "tsx --test scripts/e2e-baseline-report.test.ts",
    "test:reports:unit": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx apps/api/scripts/test-phase7-reports.ts && TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx apps/api/scripts/test-phase7-services.ts",
    "test:finance:unit": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx apps/api/scripts/test-phase6-finance.ts",
    "db:seed:phase7": "tsx apps/api/scripts/seed-phase7-reference.ts",
    "db:seed:phase9": "tsx apps/api/scripts/seed-phase9-permissions.ts",
    "db:seed:phase6": "tsx apps/api/scripts/seed-phase6-reference.ts",
    "db:reconcile:phase6": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx apps/api/scripts/reconcile-phase6-ledger.ts",
    "db:studio": "prisma studio",
    "docker:db": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:db:down": "docker compose -f docker/docker-compose.dev.yml down",
    "db:phase10:preflight": "tsx apps/api/scripts/preflight-phase10.ts",
    "db:phase10:postflight": "tsx apps/api/scripts/preflight-phase10.ts --after",
    "db:seed:phase10:permissions": "tsx apps/api/scripts/seed-phase10-permissions.ts",
    "db:seed:phase10:ports": "tsx apps/api/scripts/seed-phase10-ports.ts",
    "test:phase10:migration": "node apps/api/scripts/test-phase10-migration.cjs",
    "check:phase11:authz": "node scripts/check-phase11-authz.mjs",
    "db:seed:phase11:permissions": "tsx apps/api/scripts/seed-phase11-permissions.ts",
    "db:phase11:roles:preflight": "tsx apps/api/scripts/phase11-audit-roles.ts --preflight",
    "db:phase11:roles:grant": "tsx apps/api/scripts/phase11-audit-roles.ts --grant",
    "db:phase11:roles:verify": "tsx apps/api/scripts/phase11-audit-roles.ts --verify",
    "db:phase11:server": "node apps/api/scripts/phase11-server-workflow.cjs",
    "test:phase11:server:unit": "node --test apps/api/scripts/phase11-server-workflow.test.cjs",
    "check:phase11:audit:routes": "node scripts/check-phase11-audit-routes.mjs",
    "check:phase11:process-db": "node scripts/check-phase11-process-db-identity.mjs",
    "test:phase11:audit:unit": "node --test scripts/check-phase11-audit-routes.test.mjs scripts/check-phase11-process-db-identity.test.mjs && TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx --test apps/api/scripts/test-phase11-audit-guard.ts"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "prisma": "^5.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
