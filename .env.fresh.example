# New-server ONLY. Copy to .env.fresh.local, restrict to mode 0600, then fill
# each value privately. Do not use the existing root .env or any owner DB URL.
# Plain KEY=value lines; no quotes, shell commands, export, or inline comments.
# A unique lowercase instance ID distinguishes this install's Docker project.
FRESH_INSTANCE_ID=
# Choose duna_fresh_ followed by 3-24 lowercase letters/digits.
FRESH_DATABASE_NAME=
# Deliberate target acknowledgement: NEW_EMPTY_SERVER:<FRESH_DATABASE_NAME>
FRESH_NEW_SERVER_ACK=
# Distinct random secrets >=32 chars each; generated/stored in a password manager.
FRESH_DB_SUPER_PASSWORD=
FRESH_DB_OWNER_PASSWORD=
FRESH_DB_RUNTIME_PASSWORD=
# Owner-controlled initial administrator; password >=16 chars. Keep securely.
FRESH_ADMIN_EMAIL=
FRESH_ADMIN_PASSWORD=
# Distinct random signing secrets >=32 chars each.
FRESH_AUTH_JWT_SECRET=
FRESH_AUTH_REFRESH_SECRET=
FRESH_ATTACHMENT_URL_SECRET=
