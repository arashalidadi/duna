# Duna ERP — production environment template.
#
# Copy to the deployment path as `.env`, then `chmod 600` it. Never commit the
# real file; only this example is tracked. Generate every secret with
# `openssl rand -base64 48`.
#
# deploy/install-server.sh refuses to deploy while any value below still holds
# a shipped placeholder, so a half-configured install cannot start silently.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Production. Note that `next build` must NOT see NODE_ENV=development: Next
# refuses to prerender with a non-standard value and the build fails on
# /404, /500 and /_not-found. The installer unsets it for the build step.
NODE_ENV=production
APP_TIMEZONE=Asia/Dubai
APP_DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Loopback only: nginx fronts the dashboard, and the dashboard proxies /api/v1
# to this address server-side. Do not publish 3101 to the network.
API_HOST=127.0.0.1
API_PORT=3101
# Browser traffic is same-origin, so this list only needs the public origin(s).
# Never `*` alongside authentication.
API_CORS_ORIGINS=https://duna.example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# One application role. The installer creates the database if it is absent and
# applies the committed migrations with an administrative URL supplied
# separately as DUNA_ADMIN_DATABASE_URL (never stored in this file).
DATABASE_URL=postgresql://duna_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@127.0.0.1:5432/duna_prod?schema=public

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
AUTH_JWT_SECRET=REPLACE_openssl_rand_base64_48
AUTH_JWT_REFRESH_SECRET=REPLACE_openssl_rand_base64_48
AUTH_JWT_EXPIRES_IN=15m
AUTH_JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# The installer seeds reference data only. Demonstration records are opt-in and
# must never be written to a production database.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
# SEED_DEMO_DATA=true   # never on a production database

# ---------------------------------------------------------------------------
# Attachments (identity documents)
# ---------------------------------------------------------------------------
# Outside the repository, mode 0700, owned by the service user. Unset means
# uploads fail closed with 503.
ATTACHMENT_STORAGE_DIR=/var/lib/duna/attachments
ATTACHMENT_URL_SECRET=REPLACE_openssl_rand_base64_48
ATTACHMENT_URL_TTL_SECONDS=300
ATTACHMENT_MAX_BYTES=10485760
# Keep false until the retention period and lawful basis are recorded.
ATTACHMENT_IDENTITY_CAPTURE_ENABLED=false

# ---------------------------------------------------------------------------
# Notifications (only required for EMAIL rules)
# ---------------------------------------------------------------------------
NOTIFICATION_WORKER_ENABLED=true
# NOTIFICATION_SMTP_URL=smtps://user:password@mail.example.com:465
# NOTIFICATION_FROM_EMAIL=notifications@example.com
