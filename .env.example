# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
APP_TIMEZONE=Asia/Dubai
APP_DEFAULT_CURRENCY=USD

# ============================================================================
# API
# ============================================================================
API_HOST=0.0.0.0
API_PORT=3101
# Comma-separated allow-list. Never use * with authenticated requests.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://dashboard.3ree.eu.cc,https://dashboard.3ree.eu.cc

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string (see docker/docker-compose.dev.yml for defaults)
DATABASE_URL=postgresql://shipping:shipping_dev_pass@localhost:5432/shipping_erp?schema=public

# ============================================================================
# WEB (Next.js — copy into apps/web/.env.local)
# ============================================================================
# Client-side API base URL. Inlined into the browser bundle at build time and
# used by the centralized API client (src/lib/api/client.ts). Must end with /api/v1.
# Keep browser requests same-origin, including on hosted preview domains.
# NEXT_PUBLIC_API_URL=/api/v1
# API_INTERNAL_URL=http://127.0.0.1:3101

# ============================================================================
# AUTHENTICATION (Phase 2 will consume these)
# ============================================================================
# Use long, random values in production: `openssl rand -base64 48`
AUTH_JWT_SECRET=change-me-in-production-1
AUTH_JWT_REFRESH_SECRET=change-me-in-production-2
AUTH_JWT_EXPIRES_IN=15m
AUTH_JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# SEED (optional overrides)
# ============================================================================
# SEED_ADMIN_EMAIL=admin@shipping.local
# SEED_ADMIN_PASSWORD=YourSecurePassword

# Phase 1 — demonstration data is OPT-IN and defaults to OFF.
# Leave this unset (or anything other than the exact string "true") on any
# database that matters. When unset, `pnpm db:seed` writes ONLY the required
# structural reference data and the administrator account, but NO operator-
# managed ports/yards and no vessels, voyages, customers, cargo, inspections
# or load lists. Phase 10 ports require a separately reviewed explicit seed.
# Set it only on a development database you are happy to fill with fabricated
# sample records, and preferably use the dedicated script instead:
#     pnpm db:seed:demo        # = SEED_DEMO_DATA=true pnpm db:seed
# SEED_DEMO_DATA=true
# With the demo seed only: both demo portal accounts default to ChangeMe123!.
# Override their password if desired; rerunning the demo seed repairs ONLY these
# exact demo accounts when their stored hash does not match this value.
# SEED_PORTAL_PASSWORD=YourDevelopmentPortalPassword

# =============================================================================
# ATTACHMENTS (Phase 4). Identity documents only (DEC-092). Set on the server; never commit values.
# =============================================================================
# Absolute directory OUTSIDE the repository, writable by the API process. Unset = uploads fail closed (503).
# ATTACHMENT_STORAGE_DIR=/var/lib/duna/attachments
# Signing secret for short-lived download links, at least 32 characters: `openssl rand -base64 48`
# ATTACHMENT_URL_SECRET=
# Download link lifetime in seconds (default 300, maximum 900).
# ATTACHMENT_URL_TTL_SECONDS=300
# Per-file size cap in bytes (default 10485760 = 10 MiB; proposed, pending owner confirmation).
# ATTACHMENT_MAX_BYTES=10485760
# Identity-document capture. Keep false until the retention period and lawful basis are recorded (OQ-12).
# ATTACHMENT_IDENTITY_CAPTURE_ENABLED=false

# =============================================================================
# PHASE 10 — NOTIFICATIONS (optional transport, mandatory only for EMAIL rules)
# =============================================================================
# Poller defaults to enabled: set false to pause delivery during maintenance.
# NOTIFICATION_WORKER_ENABLED=true
# For EMAIL rules configure an SMTP/S with STARTTLS or implicit TLS and a
# verified sender address. Do not commit actual URLs or credentials here.
# NOTIFICATION_SMTP_URL=smtps://user:password@mail.example.test:465
# NOTIFICATION_FROM_EMAIL=notifications@example.test
# Without SMTP, IN_APP rules still work; EMAIL attempts fail with sanitized
# status SMTP_NOT_CONFIGURED and are retriable after configuring the transport.
